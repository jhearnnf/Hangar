{
  "name": "hangar",
  "version": "0.1.0",
  "private": true,
  "description": "A minimal tabbed terminal host. Full-screen tabs, huge scrollback, no chrome.",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "postinstall": "node tools/fix-spawn-helper.js",
    "test": "vitest run",
    "icon": "electron tools/make-icon.js",
    "exe": "powershell -NoProfile -ExecutionPolicy Bypass -File tools/make-exe.ps1",
    "app": "sh tools/make-app.sh",
    "shortcut": "powershell -NoProfile -ExecutionPolicy Bypass -File tools/install-shortcut.ps1"
  },
  "devDependencies": {
    "electron": "^43.2.0",
    "vitest": "^4.1.10"
  },
  "dependencies": {
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/addon-search": "^0.16.0",
    "@xterm/addon-unicode11": "^0.9.0",
    "@xterm/addon-web-links": "^0.12.0",
    "@xterm/addon-webgl": "^0.19.0",
    "@xterm/xterm": "^6.0.0",
    "node-pty": "^1.1.0"
  }
}
